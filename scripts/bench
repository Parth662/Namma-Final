#!/usr/bin/env bash
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_EXE="$SCRIPT_DIR/../namma/backend/python-service/venv/Scripts/python.exe"
if [ ! -f "$PYTHON_EXE" ]; then
    PYTHON_EXE="$SCRIPT_DIR/../namma/backend/python-service/venv/bin/python"
fi
"$PYTHON_EXE" "$SCRIPT_DIR/bench.py" "$@"

