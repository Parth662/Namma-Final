{
  "name": "digital-twin-3d-backend",
  "version": "1.0.0",
  "type": "module",
  "description": "Photorealistic Digital Twin & 3D Location Reconstruction Backend",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
